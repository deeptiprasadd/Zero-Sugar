# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# Step 1 — console.cloud.google.com, enable "YouTube Data API v3", create an API key.
# Free, no billing card needed.
YOUTUBE_API_KEY=

# Step 4 — apify.com, Settings -> Integrations -> API token.
APIFY_TOKEN=

# Step 6 (optional hedge) — developers.facebook.com, Graph API Explorer,
# scopes: instagram_basic, pages_show_list, pages_read_engagement.
IG_ACCESS_TOKEN=
IG_USER_ID=

# Optional - only if YouTube blocks downloads with "Sign in to confirm you're not a bot".
# Path to a cookies.txt exported from a SPARE Google account (never your main one).
# The file is a live login: keep it in secrets/ (gitignored) and delete it after use.
YOUTUBE_COOKIES_FILE=secrets/youtube_cookies.txt
